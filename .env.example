POSTGRES_DB=Smart_Task_Management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used for local non-Docker runs. Docker Compose overrides this with the db service hostname.
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-password@localhost:5432/Smart_Task_Management
